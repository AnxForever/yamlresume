{
  "name": "@yamlresume/resume-agent",
  "version": "0.12.2",
  "private": true,
  "description": "Job-tailored resume agent built on YAMLResume",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "build:watch": "tsup --watch",
    "build:clean": "rm -rf dist",
    "test": "vitest --run",
    "test:cov": "vitest --coverage --run",
    "test:watch": "vitest",
    "lint": "biome check src"
  },
  "dependencies": {
    "@yamlresume/core": "workspace:*",
    "yaml": "^2.8.2",
    "zod": "^4.3.6",
    "tslib": "^2.8.1",
    "mammoth": "^1.12.3",
    "pdfjs-dist": "^6.3.289",
    "docx": "^9.7.1"
  },
  "devDependencies": {
    "@types/node": "^24.4.0"
  }
}

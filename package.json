{
  "name": "@yamlresume/yamlresume",
  "private": true,
  "scripts": {
    "build": "pnpm -r build",
    "build:watch": "pnpm -r build:watch",
    "build:clean": "pnpm -r build:clean",
    "build:prod": "pnpm -r build:prod",
    "test": "pnpm -r test",
    "test:cov": "pnpm -r test:cov",
    "test:watch": "pnpm -r test:watch",
    "check": "pnpm check:biome --write && pnpm check:tsc && pnpm license:add",
    "check:ci": "pnpm check:biome && pnpm check:tsc && pnpm license:check",
    "check:tsc": "pnpm -r exec tsc --noEmit",
    "check:biome": "pnpm biome check --unsafe packages/*/src",
    "check:layout": "node scripts/check-layout.mjs",
    "license:add": "node scripts/addlicense.mjs",
    "license:check": "node scripts/addlicense.mjs -c",
    "prepare": "husky",
    "publish:github": "pnpm build:prod && pnpm publish -r --no-git-checks --access public",
    "commitlint": "commitlint --edit",
    "release": "commit-and-tag-version -c .versionrc.cjs",
    "local-app": "./scripts/demo.sh",
    "local-app:backup": "node scripts/local-app-data.mjs backup",
    "local-app:data-smoke": "node scripts/local-app-data-smoke.mjs",
    "local-app:crash-smoke": "node scripts/local-app-crash-smoke.mjs",
    "local-app:doctor": "node scripts/local-app-data.mjs doctor",
    "local-app:doctor-smoke": "node scripts/local-app-doctor-smoke.mjs",
    "local-app:provider-retry-smoke": "node scripts/local-app-provider-retry-smoke.mjs",
    "local-app:restore": "node scripts/local-app-data.mjs restore",
    "local-app:shutdown-smoke": "node scripts/local-app-crash-smoke.mjs --signal=SIGTERM",
    "local-app:smoke": "node scripts/local-app-smoke.mjs",
    "cli": "pnpm --filter yamlresume",
    "core": "pnpm --filter @yamlresume/core",
    "create-yamlresume": "pnpm --filter create-yamlresume",
    "json2yamlresume": "pnpm --filter json2yamlresume",
    "playground": "pnpm --filter @yamlresume/playground",
    "web": "pnpm --filter @yamlresume/web",
    "typedoc": "pnpm -r typedoc",
    "agent": "pnpm --filter @yamlresume/resume-agent",
    "agent-api": "pnpm --filter @yamlresume/resume-agent-api",
    "agent-web": "pnpm --filter @yamlresume/agent-web"
  },
  "lint-staged": {
    "packages/*/src/**/*.ts": "pnpm check"
  },
  "devDependencies": {
    "@biomejs/biome": "2.0.6",
    "@commitlint/cli": "^20.4.3",
    "@commitlint/config-conventional": "^20.5.0",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^24.4.0",
    "@vitest/coverage-v8": "^4.0.16",
    "commit-and-tag-version": "^12.6.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.6",
    "tsup": "8.3.5",
    "tsx": "^4.20.5",
    "typedoc": "^0.28.16",
    "typedoc-plugin-markdown": "^4.9.0",
    "typescript": "~5.9.3",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.0.16"
  },
  "packageManager": "pnpm@10.12.1",
  "version": "0.12.2",
  "pnpm": {
    "overrides": {
      "form-data": "^4.0.4"
    },
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ]
  }
}

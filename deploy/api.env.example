# Keep the real file at /etc/yamlresume-agent/api.env with mode 0600.
RESUME_AGENT_AUTH_MODE=enabled
RESUME_AGENT_AUTH_DB_PATH=/var/lib/yamlresume-agent/auth.sqlite
RESUME_AGENT_CREDENTIAL_KEYS='{"prod-v1":"replace-with-32-byte-base64-key"}'
RESUME_AGENT_CREDENTIAL_ACTIVE_KEY_ID=prod-v1
RESUME_AGENT_ALLOWED_ORIGIN=https://resume.example.com
RESUME_AGENT_SECURE_COOKIES=true
# Shared per-account allowance for POST /v1/chat, /v1/tailor-resume, and /v1/runs.
RESUME_AGENT_WORK_RATE_LIMIT=10
RESUME_AGENT_WORK_RATE_WINDOW_MS=900000
OPENAI_API_KEY=replace-with-provider-secret
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_MODEL=deepseek-chat
OPENAI_TIMEOUT_MS=60000
OPENAI_MAX_RETRIES=2
OPENAI_RETRY_DELAY_MS=250
# No new durable delivery begins 15 minutes after its task was created.
RESUME_AGENT_TASK_RETRY_ELAPSED_MS=900000
# Model provider: openai-compatible (default) or offline (heuristic, no model; demos only).
# RESUME_AGENT_LLM_PROVIDER=openai-compatible
# Semantic evidence retrieval (RA-018): transformers (in-process multilingual-e5-small,
# first call downloads ~130 MB), hash (tests/demos), or unset for keyword-only matching.
# RESUME_AGENT_SEMANTIC_MATCHING=transformers

# Keep the real file at /etc/yamlresume-agent/api.env with mode 0600.
RESUME_AGENT_AUTH_MODE=enabled
RESUME_AGENT_AUTH_DB_PATH=/var/lib/yamlresume-agent/auth.sqlite
RESUME_AGENT_CREDENTIAL_KEYS='{"prod-v1":"replace-with-32-byte-base64-key"}'
RESUME_AGENT_CREDENTIAL_ACTIVE_KEY_ID=prod-v1
RESUME_AGENT_ALLOWED_ORIGIN=https://resume.example.com
RESUME_AGENT_SECURE_COOKIES=true
OPENAI_API_KEY=replace-with-provider-secret
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_MODEL=deepseek-chat
OPENAI_TIMEOUT_MS=60000
OPENAI_MAX_RETRIES=2
OPENAI_RETRY_DELAY_MS=250
